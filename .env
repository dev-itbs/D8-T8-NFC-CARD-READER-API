# NFC Card Reader API Configuration

# Reader Configuration
READER_PORT=100          # 100 = USB, 0-3 = Serial ports
READER_BAUD=115200       # Baud rate: 9600-115200

# Server Configuration
SERVER_ADDR=:8080        # Server bind address

# DLL Configuration
DLL_PATH=dcrf32.dll      # Path to the DCRF32 DLL file

# Logging Configuration
LOG_FILE=logs/reader.log # Log file path (will be created if not exists)

# Graceful Shutdown
GRACEFUL_WAIT=5          # Graceful shutdown timeout in seconds

# Branca Token Encoding
BRANCA_SALT=change-this-to-a-strong-secret-salt  # Salt used for SHA-based Branca key derivation
